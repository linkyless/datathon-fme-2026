#!/bin/sh
# Bloquea commits que llevan claves, el .env o datos. Se activa una vez con:
#   git config core.hooksPath .githooks
fallo=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    .env|*/.env|*.key)
      echo "BLOQUEADO: $f es un archivo de claves. Sácalo con: git restore --staged $f"; fallo=1 ;;
    *.csv|*.parquet|*.pkl|*.joblib|*.npy)
      echo "BLOQUEADO: $f parece datos o un modelo. Los datos no se suben."; fallo=1 ;;
  esac
done
if git diff --cached -U0 | grep '^+' | grep -v '^+++' \
   | grep -Eq 'rt_[A-Za-z0-9]{12,}|(API_KEY|api_key|apiKey|Bearer)[^A-Za-z0-9{]{1,4}[A-Za-z0-9_.-]{24,}'; then
  echo "BLOQUEADO: parece que hay una clave en el código. Muévela al .env."; fallo=1
fi
if [ $fallo -ne 0 ]; then
  echo "Commit cancelado. Si es un falso positivo, avisa al equipo antes de saltártelo."
  exit 1
fi
exit 0
