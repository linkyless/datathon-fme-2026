{
  "$schema": "https://opencode.ai/config.json",
  "model": "helmcode/glm5.3-flash",
  "instructions": [
    "README.md",
    "docs/challenge.md",
    "docs/rawtree.md"
  ],
  "provider": {
    "helmcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Helmcode",
      "options": {
        "baseURL": "https://api.helmcode.com/v1"
      },
      "models": {
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "qwen3.6": {
          "name": "Qwen 3.6",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "gemma4": {
          "name": "Gemma 4",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "rawtree": {
        "type": "remote",
        "url": "https://mcp.rawtree.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RAWTREE_API_KEY}"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "starter/*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    }
  ]
}